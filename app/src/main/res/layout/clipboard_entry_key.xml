<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

    <!-- Content container with background -->
    <LinearLayout
        android:id="@+id/clipboard_entry_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
                android:id="@+id/clipboard_entry_pinned_icon"
                android:contentDescription="@string/clipboard_history_pinned_first"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="4dp"/>

        <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
             We just need to ignore the system's audio and haptic feedback settings. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:hapticFeedbackEnabled="false"
            android:soundEffectsEnabled="false"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/clipboard_entry_image_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/clipboard_entry_text_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>